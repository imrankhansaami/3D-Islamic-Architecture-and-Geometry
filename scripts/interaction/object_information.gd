class_name ObjectInformation
extends RefCounted
## Contextual information for every interactive architectural object:
## what it is, how it is generated and the mathematics behind it.
## `pattern_id` links an object to a pattern in the PatternLibrary.

static func get_info(id: String) -> Dictionary:
	return _database().get(id, {
		"name": id.capitalize(),
		"description": "An element of the procedurally generated environment.",
		"construction": "Generated by the project's geometry engine.",
		"math": "",
		"pattern_id": "",
	})


static func all_ids() -> PackedStringArray:
	var ids := PackedStringArray()
	for key: String in _database():
		ids.append(key)
	return ids


