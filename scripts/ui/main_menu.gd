extends Control
## Main menu: the application's front door.
##
## A rotating 12-fold rosette generated by the geometry engine is displayed in
## the background; the menu itself is drawn over it in the application theme.

signal screen_requested(id: String)

const MENU_ITEMS: Array = [
	["Explore Architecture", "world", true, "Walk through the procedurally generated courtyard, dome, minarets and arcades."],
	["Geometry Laboratory", "lab", true, "Generate Islamic geometric patterns from mathematical parameters and edit them live."],
	["3D Transformation Studio", "studio", false, "Extrude a pattern into a 3D object, apply materials and inspect it from every angle."],
	["Mathematics & Learning", "learning", false, "Interactive demonstrations of symmetry, polygons, star polygons and tessellation."],
	["Settings", "settings", false, "Graphics quality, time-of-day lighting and control preferences."],
	["Exit", "exit", false, "Close NOOR."],
]

var _viewport: PatternViewport


func _ready() -> void:
	_build_background()
	_build_shade()
	_build_frame()
	_build_content()


func _build_background() -> void:
	_viewport = preload("res://scenes/geometry/pattern_viewport.tscn").instantiate()
	_viewport.set_anchors_preset(Control.PRESET_FULL_RECT)
	_viewport.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_viewport)
	_viewport.set_environment_preset("night_gold")

	# A large, slowly rotating 12-fold rosette — generated, not modelled.
	var config: PatternConfig = PatternLibrary.make_preset(PatternConfig.PatternType.ROSETTE)
	config.star_points = 12
	config.repetition = 2
	config.symmetry_folds = 12
	config.line_thickness = 0.045
	config.extrusion_depth = 0.16
	config.outer_radius = 2.6
	config.inner_radius_ratio = 0.42
	config.apply_palette(0)
	config.clamp_values()
	var geo := PatternEngine.generate(config)
	var layers := MeshBuilder.build_pattern_layers(geo, config)
	_viewport.clear_model()
	var colors := [config.color_fill, config.color_accent, config.color_line]
	var roles := ["fill", "accent", "line"]
	for i in layers.size():
		var mesh: ArrayMesh = layers[i]
		if mesh == null:
			continue
		var mi := MeshInstance3D.new()
		mi.mesh = mesh
		mi.material_override = MaterialLibrary.pattern_material(colors[i], roles[i])
		_viewport.add_model_node(mi)
	_viewport.set_backdrop_radius(config.outer_radius * 1.28)
	_viewport.set_orbit(0.30, -0.20)
	_viewport.frame_content(1.35)
	_viewport.set_screen_offset(0.34, -0.06)
	_viewport.set_autorotate(true, 0.45, "sway")


func _build_shade() -> void:
	var shade := ColorRect.new()
	shade.set_anchors_preset(Control.PRESET_FULL_RECT)
	shade.color = Color(0.02, 0.035, 0.055, 0.20)
	shade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(shade)
	# left-side gradient so the menu column keeps its contrast
	var gradient := Gradient.new()
	gradient.colors = PackedColorArray([
		Color(0.016, 0.031, 0.047, 0.78),
		Color(0.016, 0.031, 0.047, 0.0),
	])
	var texture := GradientTexture2D.new()
	texture.gradient = gradient
	texture.width = 512
	texture.height = 8
	texture.fill_from = Vector2(0.0, 0.5)
	texture.fill_to = Vector2(1.0, 0.5)
	var gradient_rect := TextureRect.new()
	gradient_rect.texture = texture
	gradient_rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	gradient_rect.stretch_mode = TextureRect.STRETCH_SCALE
	gradient_rect.set_anchors_preset(Control.PRESET_FULL_RECT)
	gradient_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(gradient_rect)


func _build_frame() -> void:
	var frame := OrnamentalBackground.new()
	frame.set_anchors_preset(Control.PRESET_FULL_RECT)
	frame.draw_background = false
	frame.draw_frame = true
	frame.frame_margin = 20.0
	add_child(frame)


func _build_content() -> void:
	var margin := MarginContainer.new()
	margin.set_anchors_preset(Control.PRESET_FULL_RECT)
	margin.add_theme_constant_override("margin_left", 84)
	margin.add_theme_constant_override("margin_right", 84)
	margin.add_theme_constant_override("margin_top", 56)
	margin.add_theme_constant_override("margin_bottom", 56)
	add_child(margin)

	var hbox := HBoxContainer.new()
	margin.add_child(hbox)

	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 10)
	column.alignment = BoxContainer.ALIGNMENT_CENTER
	column.custom_minimum_size = Vector2(430, 0)
	hbox.add_child(column)

	var title := UIHelpers.label("NOOR", 68, NoorTheme.GOLD_LIGHT)
	title.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.6))
	title.add_theme_constant_override("shadow_offset_x", 2)
	title.add_theme_constant_override("shadow_offset_y", 3)
	column.add_child(title)

	var subtitle := UIHelpers.label("Procedural Islamic Geometry & Heritage Architecture", 17, NoorTheme.IVORY)
	subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(subtitle)

	var tagline := UIHelpers.muted("An interactive 3D computer graphics laboratory", 13)
	column.add_child(tagline)

	column.add_child(UIHelpers.spacer(10))
	column.add_child(HSeparator.new())
	column.add_child(UIHelpers.spacer(12))

	for item: Array in MENU_ITEMS:
		var text: String = item[0]
		var target: String = item[1]
		var primary: bool = item[2]
		var tip: String = item[3]
		var button := UIHelpers.button(text, primary, tip)
		button.custom_minimum_size = Vector2(320, 0)
		if target == "exit":
			button.theme_type_variation = &"DangerButton"
			button.pressed.connect(func() -> void: get_tree().quit())
		else:
			button.pressed.connect(func() -> void: screen_requested.emit(target))
		column.add_child(button)

	column.add_child(UIHelpers.spacer(14))
	var credit := UIHelpers.muted("CSE 400 — Final Year Project · Sylhet International University", 12)
	column.add_child(credit)
	var version := UIHelpers.muted("NOOR %s · Godot 4 · all geometry generated at runtime" % "v1.0", 11)
	version.modulate = Color(1, 1, 1, 0.7)
	column.add_child(version)

	# spacer pushes the column to the left
	var right_spacer := Control.new()
	right_spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	right_spacer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hbox.add_child(right_spacer)

	var hint := UIHelpers.muted("Drag to orbit · wheel to zoom · F12 saves a screenshot", 12)
	hint.set_anchors_preset(Control.PRESET_BOTTOM_RIGHT)
	hint.offset_left = -420
	hint.offset_top = -34
	hint.offset_right = -30
	hint.offset_bottom = -12
	hint.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	add_child(hint)
